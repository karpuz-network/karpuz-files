# Line endings
*.toml text eol=lf
*.txt text eol=lf
*.cfg text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.mcmeta text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.jar binary
*.zip binary
*.gz binary
*.ogg binary
*.mp3 binary
*.wav binary

# FancyMenu stores these as exact byte-oriented state files. Git line-ending
# conversion would make the raw GitHub file differ from the pack index hash.
*.lewidget binary
config/fancymenu/user_variables.db binary
